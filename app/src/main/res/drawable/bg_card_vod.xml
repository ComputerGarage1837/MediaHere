<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="-2dp" android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
                <shape android:shape="rectangle"><corners android:radius="22dp" /><solid android:color="#552BD96B" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient android:angle="0" android:startColor="#15803D" android:centerColor="#14532D" android:endColor="#052E16" />
                    <stroke android:width="2dp" android:color="#86EFAC" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="0" android:startColor="#15803D" android:centerColor="#14532D" android:endColor="#052E16" />
            <stroke android:width="2dp" android:color="#86EFAC" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="0" android:startColor="#166534" android:centerColor="#14532D" android:endColor="#052E16" />
            <stroke android:width="1.5dp" android:color="#2BD96B" />
        </shape>
    </item>
</selector>
